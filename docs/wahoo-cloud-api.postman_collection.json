{
  "info": {
    "name": "Wahoo Cloud API",
    "description": "Manual-test collection covering every endpoint in the Wahoo Cloud API as of 2026-06. Mirrors `docs/wahoo-cloud-api-cli.md`. Set `client_id`, `client_secret`, `redirect_uri` in the collection variables, run the OAuth flow once, then call any read endpoint. Write endpoints (POST/PUT/DELETE on workouts, plans, routes, power_zones) need the matching `_write` scope — re-authorize with the wider scope when you want to try them.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://api.wahooligan.com",
      "type": "string"
    },
    {
      "key": "client_id",
      "value": "",
      "type": "string",
      "description": "Wahoo developer app client id"
    },
    {
      "key": "client_secret",
      "value": "",
      "type": "string",
      "description": "Wahoo developer app client secret"
    },
    {
      "key": "redirect_uri",
      "value": "https://localhost/callback",
      "type": "string",
      "description": "Must match the redirect URI registered in the Wahoo developer app"
    },
    {
      "key": "scope",
      "value": "user_read workouts_read power_zones_read plans_read routes_read offline_data",
      "type": "string",
      "description": "Read-only browsing default. For write endpoints, append the matching `_write` scopes (user_write, workouts_write, plans_write, routes_write, power_zones_write) and re-run the authorize step."
    },
    {
      "key": "auth_code",
      "value": "",
      "type": "string",
      "description": "Paste the ?code= value from the redirected browser URL"
    },
    {
      "key": "access_token",
      "value": "",
      "type": "string",
      "description": "Populated by the token exchange / refresh requests"
    },
    {
      "key": "refresh_token",
      "value": "",
      "type": "string",
      "description": "Populated by the token exchange / refresh requests"
    },
    {
      "key": "workout_id",
      "value": "",
      "type": "string",
      "description": "Used by workout detail / summary / plan-link requests"
    },
    {
      "key": "plan_id",
      "value": "",
      "type": "string",
      "description": "Used by plan detail / update / delete requests"
    },
    {
      "key": "route_id",
      "value": "",
      "type": "string",
      "description": "Used by route detail / update / delete requests"
    },
    {
      "key": "power_zone_id",
      "value": "",
      "type": "string",
      "description": "Used by power-zone detail / update / delete requests"
    },
    {
      "key": "upload_token",
      "value": "",
      "type": "string",
      "description": "Returned by POST /v1/workout_file_uploads — used to poll processing status"
    },
    {
      "key": "per_page",
      "value": "20",
      "type": "string"
    },
    {
      "key": "page",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "OAuth",
      "description": "Step 1: build the authorize URL in a browser and copy the ?code= from the redirect. Steps 2–3 stay in Postman.",
      "item": [
        {
          "name": "1. Build authorize URL (open in browser)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/oauth/authorize?client_id={{client_id}}&redirect_uri={{redirect_uri}}&response_type=code&scope={{scope}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "oauth",
                "authorize"
              ],
              "query": [
                { "key": "client_id", "value": "{{client_id}}" },
                { "key": "redirect_uri", "value": "{{redirect_uri}}" },
                { "key": "response_type", "value": "code" },
                { "key": "scope", "value": "{{scope}}" }
              ]
            },
            "description": "Right-click this request → Copy URL, paste in a browser, authorize. Wahoo redirects to `redirect_uri?code=…` — copy the code into the `auth_code` collection variable."
          },
          "response": []
        },
        {
          "name": "2. Exchange code for tokens",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  pm.collectionVariables.set('access_token', body.access_token);",
                  "  pm.collectionVariables.set('refresh_token', body.refresh_token);",
                  "  console.log('Stored access_token + refresh_token. Expires in', body.expires_in, 's');",
                  "} else {",
                  "  console.log('Token exchange failed:', pm.response.text());",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "client_id", "value": "{{client_id}}", "type": "text" },
                { "key": "client_secret", "value": "{{client_secret}}", "type": "text" },
                { "key": "grant_type", "value": "authorization_code", "type": "text" },
                { "key": "code", "value": "{{auth_code}}", "type": "text" },
                { "key": "redirect_uri", "value": "{{redirect_uri}}", "type": "text" }
              ]
            },
            "url": {
              "raw": "{{base_url}}/oauth/token",
              "host": [ "{{base_url}}" ],
              "path": [ "oauth", "token" ]
            },
            "description": "Test script stores `access_token` + `refresh_token` into the collection variables on a 200 response."
          },
          "response": []
        },
        {
          "name": "3. Refresh access token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  pm.collectionVariables.set('access_token', body.access_token);",
                  "  pm.collectionVariables.set('refresh_token', body.refresh_token);",
                  "  console.log('Tokens refreshed. New access token expires in', body.expires_in, 's');",
                  "} else {",
                  "  console.log('Refresh failed:', pm.response.text());",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "client_id", "value": "{{client_id}}", "type": "text" },
                { "key": "client_secret", "value": "{{client_secret}}", "type": "text" },
                { "key": "grant_type", "value": "refresh_token", "type": "text" },
                { "key": "refresh_token", "value": "{{refresh_token}}", "type": "text" }
              ]
            },
            "url": {
              "raw": "{{base_url}}/oauth/token",
              "host": [ "{{base_url}}" ],
              "path": [ "oauth", "token" ]
            },
            "description": "Wahoo rotates the refresh token on every refresh — the test script auto-stores the new one."
          },
          "response": []
        }
      ]
    },
    {
      "name": "User",
      "description": "Authenticated user profile. `user_read` for the GET, `user_write` for the PUT.",
      "item": [
        {
          "name": "GET /v1/user",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/v1/user",
              "host": [ "{{base_url}}" ],
              "path": [ "v1", "user" ]
            },
            "description": "Returns the Wahoo user profile (id, first/last, height, weight, email…). The id is the canonical account identifier used as HAWahooligan's `unique_id`."
          },
          "response": []
        },
        {
          "name": "PUT /v1/user",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user\": {\n    \"weight\": 75.0,\n    \"height\": 180\n  }\n}"
            },
            "url": {
              "raw": "{{base_url}}/v1/user",
              "host": [ "{{base_url}}" ],
              "path": [ "v1", "user" ]
            },
            "description": "Update the authenticated user. Needs `user_write` scope. Editable fields include weight (kg), height (cm), gender, birth date — see Wahoo docs for the full list."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Workouts",
      "description": "List + per-workout read endpoints, plus the write endpoints for scheduling workouts. The list response carries a partial summary; call the per-workout endpoint for the full summary.",
      "item": [
        {
          "name": "GET /v1/workouts (paginated)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/v1/workouts?per_page={{per_page}}&page={{page}}",
              "host": [ "{{base_url}}" ],
              "path": [ "v1", "workouts" ],
              "query": [
                { "key": "per_page", "value": "{{per_page}}" },
                { "key": "page", "value": "{{page}}" }
              ]
            },
            "description": "Sorted by `starts` desc. `workout_summary` is often null in the listing — fetch the per-workout endpoint for the full payload."
          },
          "response": []
        },
        {
          "name": "GET /v1/workouts/:id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/v1/workouts/{{workout_id}}",
              "host": [ "{{base_url}}" ],
              "path": [ "v1", "workouts", "{{workout_id}}" ]
            },
            "description": "Set the `workout_id` collection variable first. Always includes `workout_summary` when one exists."
          },
          "response": []
        },
        {
          "name": "GET /v1/workouts/:id/workout_summary",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/v1/workouts/{{workout_id}}/workout_summary",
              "host": [ "{{base_url}}" ],
              "path": [ "v1", "workouts", "{{workout_id}}", "workout_summary" ]
            },
            "description": "Returns just the summary record (distance, durations, avg/max power, heart_rate_avg, file URLs). Useful when you already have the parent workout id but want to skip the parent's metadata."
          },
          "response": []
        },
        {
          "name": "GET /v1/workouts/:id/plans",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/v1/workouts/{{workout_id}}/plans",
              "host": [ "{{base_url}}" ],
              "path": [ "v1", "workouts", "{{workout_id}}", "plans" ]
            },
            "description": "Lists structured plans associated with the workout (intervals, target zones). Needs `plans_read` scope."
          },
          "response": []
        },
        {
          "name": "POST /v1/workouts (schedule)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"workout\": {\n    \"name\": \"Sweet spot intervals\",\n    \"starts\": \"2026-06-15T17:00:00Z\",\n    \"minutes\": 60,\n    \"workout_type_id\": 0\n  }\n}"
            },
            "url": {
              "raw": "{{base_url}}/v1/workouts",
              "host": [ "{{base_url}}" ],
              "path": [ "v1", "workouts" ]
            },
            "description": "Schedule a future workout. Needs `workouts_write` scope. Pair with POST /v1/plans to attach a structured plan."
          },
          "response": []
        },
        {
          "name": "PUT /v1/workouts/:id",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"workout\": {\n    \"name\": \"Updated session name\"\n  }\n}"
            },
            "url": {
              "raw": "{{base_url}}/v1/workouts/{{workout_id}}",
              "host": [ "{{base_url}}" ],
              "path": [ "v1", "workouts", "{{workout_id}}" ]
            },
            "description": "Update scheduled workout fields. Needs `workouts_write` scope."
          },
          "response": []
        },
        {
          "name": "DELETE /v1/workouts/:id",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/v1/workouts/{{workout_id}}",
              "host": [ "{{base_url}}" ],
              "path": [ "v1", "workouts", "{{workout_id}}" ]
            },
            "description": "Delete a workout. Needs `workouts_write` scope. Use cautiously — Wahoo may decline to delete workouts already synced to a head unit."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Workout file uploads",
      "description": "Push an external FIT into the Wahoo cloud and poll for the processing result. Needs `workouts_write`.",
      "item": [
        {
          "name": "POST /v1/workout_file_uploads",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  if (body.token) {",
                  "    pm.collectionVariables.set('upload_token', body.token);",
                  "    console.log('Stored upload_token =', body.token);",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "description": "FIT workout file"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/v1/workout_file_uploads",
              "host": [ "{{base_url}}" ],
              "path": [ "v1", "workout_file_uploads" ]
            },
            "description": "Upload a FIT for asynchronous processing. Response carries a `token` — use it with the status endpoint to poll. Test script auto-stores the token into `upload_token`."
          },
          "response": []
        },
        {
          "name": "GET /v1/workout_file_uploads/:token",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/v1/workout_file_uploads/{{upload_token}}",
              "host": [ "{{base_url}}" ],
              "path": [ "v1", "workout_file_uploads", "{{upload_token}}" ]
            },
            "description": "Poll the upload status. Returns the processed workout id once the FIT is ingested."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Power zones",
      "description": "Per-sport FTP / critical-power / zone-boundary records. Read with `power_zones_read`, write with `power_zones_write`. HAWahooligan reads the primary record on a daily poll.",
      "item": [
        {
          "name": "GET /v1/power_zones",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/v1/power_zones",
              "host": [ "{{base_url}}" ],
              "path": [ "v1", "power_zones" ]
            },
            "description": "Lists every power-zone record. Most users have one per sport (Biking, Running). The primary is the most-recently-updated record with non-zero FTP."
          },
          "response": []
        },
        {
          "name": "GET /v1/power_zones/:id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/v1/power_zones/{{power_zone_id}}",
              "host": [ "{{base_url}}" ],
              "path": [ "v1", "power_zones", "{{power_zone_id}}" ]
            },
            "description": "Single record by id."
          },
          "response": []
        },
        {
          "name": "POST /v1/power_zones",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"power_zone\": {\n    \"ftp\": 250,\n    \"critical_power\": 260,\n    \"zone_count\": 7,\n    \"zone_1\": 137,\n    \"zone_2\": 187,\n    \"zone_3\": 225,\n    \"zone_4\": 262,\n    \"zone_5\": 300,\n    \"zone_6\": 375,\n    \"zone_7\": 450,\n    \"workout_type_id\": 0\n  }\n}"
            },
            "url": {
              "raw": "{{base_url}}/v1/power_zones",
              "host": [ "{{base_url}}" ],
              "path": [ "v1", "power_zones" ]
            },
            "description": "Create a power-zone profile for a sport. Needs `power_zones_write` scope. The seven zone boundaries are absolute watts, not %FTP."
          },
          "response": []
        },
        {
          "name": "PUT /v1/power_zones/:id",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"power_zone\": {\n    \"ftp\": 260\n  }\n}"
            },
            "url": {
              "raw": "{{base_url}}/v1/power_zones/{{power_zone_id}}",
              "host": [ "{{base_url}}" ],
              "path": [ "v1", "power_zones", "{{power_zone_id}}" ]
            },
            "description": "Update a power-zone record. Needs `power_zones_write` scope. Useful after an FTP test."
          },
          "response": []
        },
        {
          "name": "DELETE /v1/power_zones/:id",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/v1/power_zones/{{power_zone_id}}",
              "host": [ "{{base_url}}" ],
              "path": [ "v1", "power_zones", "{{power_zone_id}}" ]
            },
            "description": "Delete a power-zone record. Needs `power_zones_write` scope."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Plans",
      "description": "Structured workouts. Plans can be linked to a scheduled workout so they show on the head unit. Read with `plans_read`, write with `plans_write`.",
      "item": [
        {
          "name": "GET /v1/plans",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/v1/plans",
              "host": [ "{{base_url}}" ],
              "path": [ "v1", "plans" ]
            },
            "description": "List every plan in the user's library."
          },
          "response": []
        },
        {
          "name": "GET /v1/plans/:id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/v1/plans/{{plan_id}}",
              "host": [ "{{base_url}}" ],
              "path": [ "v1", "plans", "{{plan_id}}" ]
            },
            "description": "Single plan by id."
          },
          "response": []
