              "raw": "{{base_url}}/v1/plans/{{plan_id}}",
              "host": [ "{{base_url}}" ],
              "path": [ "v1", "plans", "{{plan_id}}" ]
            },
            "description": "Delete a plan from the library. Needs `plans_write` scope."
          },
          "response": []
        }
      ]
    },
